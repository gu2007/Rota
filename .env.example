# Copie este arquivo para .env e preencha.
PORT=3000

# Banco: sqlserver (PC, padrão) ou postgres (servidor). No servidor use DB_PORT=5432.
DB_TIPO=sqlserver
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=Rota
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Deixe DB_SERVER vazio (ou rode "npm run demo") para abrir o painel com dados de exemplo.

# IA (Google Gemini) para perguntas abertas dos formulários.
# Pegue a chave em https://aistudio.google.com/apikey.
# Sem chave, o Rota pula vagas que tenham perguntas abertas.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash

# Navegador: usa o Google Chrome instalado. NAVEGADOR_OCULTO=true esconde a janela (não recomendado).
NAVEGADOR_CANAL=chrome

# Como o bot entra na Gupy quando ela pede login: linkedin | google | nenhum
GUPY_LOGIN=linkedin
NAVEGADOR_OCULTO=false

# Alertas de vaga do Gmail (LinkedIn, Gupy, InfoJobs...). O bot só LÊ os e-mails.
# GMAIL_SENHA_APP é uma "senha de app" do Google (16 letras), NÃO a sua senha do Gmail:
# myaccount.google.com/apppasswords (precisa da verificação em duas etapas ligada).
GMAIL_USUARIO=
GMAIL_SENHA_APP=

# WhatsApp para os avisos dos processos seletivos (55 + DDD + número, só dígitos)
# Depois rode "npm run whatsapp:conectar" e escaneie o QR Code.
WHATSAPP_NUMERO=
